# Required for live Gemini diagnosis. Leave empty to use the labeled,
# deterministic fallback during offline development and tests.
GEMINI_API_KEY=

# Exact Gemini 3.5+ model verified through this project's contest account.
GEMINI_MODEL=gemini-3.6-flash
# Vertex AI backend (recommended for demo: uses GCP credits, real quotas)
# GEMINI_BACKEND=vertex
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1
